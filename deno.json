{
  "imports": {
    "lume/": "https://cdn.jsdelivr.net/gh/lumeland/lume@30dc98eb08406cb16310e1931d936a31eab6f65c/",
    "top/": "https://cdn.jsdelivr.net/gh/tarugoconf/top@16c75370dcea99eb3be1b1469a623404d04bcb85/",
    "lume/cms/": "https://cdn.jsdelivr.net/gh/lumeland/cms@718683a5d718100ef5a19a891b61e151cee9c622/",
    "lume/jsx-runtime": "https://deno.land/x/ssx@v0.1.10/jsx-runtime.ts"
  },
  "tasks": {
    "lume": "echo \"import 'lume/cli.ts'\" | deno run -A --env-file -",
    "build": "deno task lume",
    "serve": "deno task lume -s",
    "cms": "deno task lume cms",
    "cms:prod": "deno serve -A --env-file https://deno.land/x/lume_cms_adapter@v0.2.2/mod.ts"
  },
  "compilerOptions": {
    "types": [
      "lume/types.ts"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "lume"
  },
  "unstable": [
    "temporal",
    "fmt-component"
  ],
  "lint": {
    "plugins": [
      "https://cdn.jsdelivr.net/gh/lumeland/lume@30dc98eb08406cb16310e1931d936a31eab6f65c/lint.ts"
    ]
  }
}
