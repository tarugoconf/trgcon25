{
  "imports": {
    "lume/": "https://deno.land/x/lume@v3.0.3/",
    "top/": "https://cdn.jsdelivr.net/gh/tarugoconf/top@da2ab0db757f2180e9a034ee90b8d1a61c25cc8b/",
    "lume/cms/": "https://cdn.jsdelivr.net/gh/lumeland/cms@0.12.0/",
    "lume/jsx-runtime": "https://deno.land/x/ssx@v0.1.10/jsx-runtime.ts"
  },
  "tasks": {
    "lume": "echo \"import 'lume/cli.ts'\" | deno run -A --env-file -",
    "build": "deno task lume",
    "serve": "deno task lume -s",
    "cms": "deno task lume cms",
    "cms:prod": "deno serve -A --env-file https://deno.land/x/lume_cms_adapter@v0.2.2/mod.ts"
  },
  "compilerOptions": {
    "types": [
      "lume/types.ts"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "lume"
  },
  "unstable": [
    "temporal",
    "fmt-component"
  ],
  "lint": {
    "plugins": [
      "https://deno.land/x/lume@v3.0.3/lint.ts"
    ]
  }
}
